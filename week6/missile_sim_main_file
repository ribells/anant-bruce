import bpy
import bmesh
import numpy as np
import math
from mathutils import Vector, Matrix
import requests
import os

# Earth parameters
EARTH_RADIUS = 6371000  # meters
EARTH_TEXTURE_URL = "https://eoimages.gsfc.nasa.gov/images/imagerecords/73000/73909/world.topo.bathy.200412.3x5400x2700.jpg"

# Global variables for blender_state_fn
_missile_state_cache = {
    'prev_pos': None,
    'prev_time': None,
    'missile_obj': None
}

def download_earth_texture():
    """Download Earth texture if not already present"""
    texture_path = bpy.path.abspath("//earth_texture.jpg")
    
    if not os.path.exists(texture_path):
        print("Downloading Earth texture...")
        try:
            response = requests.get(EARTH_TEXTURE_URL)
            response.raise_for_status()
            
            with open(texture_path, 'wb') as f:
                f.write(response.content)
            print(f"Earth texture downloaded to {texture_path}")
        except Exception as e:
            print(f"Failed to download texture: {e}")
            return None
    
    return texture_path

def clear_scene():
    """Clear default objects"""
    bpy.ops.object.select_all(action='SELECT')
    bpy.ops.object.delete(use_global=False)

def create_earth_with_texture():
    """Create Earth sphere with realistic texture"""
    # Create UV sphere for Earth
    bpy.ops.mesh.primitive_uv_sphere_add(radius=EARTH_RADIUS/1000, location=(0, 0, 0))
    earth = bpy.context.active_object
    earth.name = "Earth"
    
    # Download and apply texture
    texture_path = download_earth_texture()
    if texture_path:
        # Create material
        mat = bpy.data.materials.new(name="EarthMaterial")
        mat.use_nodes = True
        nodes = mat.node_tree.nodes
        links = mat.node_tree.links
        
        # Clear default nodes
        nodes.clear()
        
        # Add nodes
        output_node = nodes.new(type='ShaderNodeOutputMaterial')
        bsdf_node = nodes.new(type='ShaderNodeBsdfPrincipled')
        tex_image_node = nodes.new(type='ShaderNodeTexImage')
        tex_coord_node = nodes.new(type='ShaderNodeTexCoord')
        mapping_node = nodes.new(type='ShaderNodeMapping')
        
        # Load texture
        try:
            tex_image_node.image = bpy.data.images.load(texture_path)
        except Exception as e:
            print(f"Failed to load texture: {e}")
        
        # Connect nodes
        links.new(tex_coord_node.outputs['Generated'], mapping_node.inputs['Vector'])
        links.new(mapping_node.outputs['Vector'], tex_image_node.inputs['Vector'])
        links.new(tex_image_node.outputs['Color'], bsdf_node.inputs['Base Color'])
        links.new(bsdf_node.outputs['BSDF'], output_node.inputs['Surface'])
        
        # Assign material
        earth.data.materials.append(mat)
    
    return earth

def latlon_to_ecef(lat, lon, alt=0):
    """Convert latitude/longitude to ECEF coordinates"""
    lat_rad = math.radians(lat)
    lon_rad = math.radians(lon)
    
    N = EARTH_RADIUS / math.sqrt(1 - 0.00669437999014 * math.sin(lat_rad)**2)
    
    x = (N + alt) * math.cos(lat_rad) * math.cos(lon_rad)
    y = (N + alt) * math.cos(lat_rad) * math.sin(lon_rad)
    z = (N * (1 - 0.00669437999014) + alt) * math.sin(lat_rad)
    
    return np.array([x, y, z])

def ecef_to_blender(ecef_pos):
    """Convert ECEF coordinates to Blender world coordinates"""
    # Scale down for Blender (Earth radius = 6371 units in Blender)
    scale_factor = 1000  # 1 Blender unit = 1 km
    return ecef_pos / scale_factor

def create_missile():
    """Create missile object"""
    # Create simple missile shape
    bpy.ops.mesh.primitive_cylinder_add(radius=0.5, depth=5, location=(0, 0, 0))
    missile = bpy.context.active_object
    missile.name = "Missile"
    
    # Rotate to point forward
    missile.rotation_euler = (math.radians(90), 0, 0)
    
    # Store reference for blender_state_fn
    _missile_state_cache['missile_obj'] = missile
    
    return missile

def calculate_trajectory_points(start_lat, start_lon, end_lat, end_lon, num_points=100):
    """Calculate ballistic trajectory points"""
    start_ecef = latlon_to_ecef(start_lat, start_lon, 100000)  # 100km altitude
    end_ecef = latlon_to_ecef(end_lat, end_lon, 0)
    
    points = []
    for i in range(num_points + 1):
        t = i / num_points
        
        # Simple ballistic arc
        pos = start_ecef + t * (end_ecef - start_ecef)
        
        # Add parabolic height component
        height = 4 * t * (1 - t) * 500000  # 500km max height
        height_vector = pos / np.linalg.norm(pos) * height
        pos += height_vector
        
        points.append(ecef_to_blender(pos))
    
    return points

def animate_missile_trajectory(missile, trajectory_points):
    """Animate missile along trajectory"""
    scene = bpy.context.scene
    scene.frame_start = 1
    scene.frame_end = len(trajectory_points)
    
    for frame, point in enumerate(trajectory_points, 1):
        scene.frame_set(frame)
        
        missile.location = point
        
        # Calculate rotation to face direction of travel
        if frame < len(trajectory_points):
            next_point = trajectory_points[frame] if frame < len(trajectory_points) - 1 else trajectory_points[-1]
            direction = Vector(next_point) - Vector(point)
            if direction.length > 0:
                direction.normalize()
                # Convert direction to rotation
                rot_quat = direction.to_track_quat('-Z', 'Y')
                missile.rotation_euler = rot_quat.to_euler()
        
        missile.keyframe_insert(data_path="location", index=-1)
        missile.keyframe_insert(data_path="rotation_euler", index=-1)

def blender_state_fn(t):
    """
    Returns current (p_ecef, v_ecef) at time t
    
    Args:
        t: Time in seconds from simulation start
    
    Returns:
        tuple: (p_ecef, v_ecef) where both are numpy arrays of shape (3,)
    """
    global _missile_state_cache
    
    # Get missile object
    missile = _missile_state_cache.get('missile_obj')
    if missile is None:
        missile = bpy.data.objects.get('Missile')
        if missile is None:
            raise ValueError("Missile object not found in Blender scene")
        _missile_state_cache['missile_obj'] = missile
    
    # Calculate frame from time (assuming 24 fps)
    fps = bpy.context.scene.render.fps
    frame = max(1, int(t * fps) + 1)
    
    # Ensure frame is within bounds
    frame = min(frame, bpy.context.scene.frame_end)
    
    # Set frame and get position
    bpy.context.scene.frame_set(frame)
    
    # Get Blender position and convert to ECEF
    blender_pos = np.array(missile.location)
    p_ecef = blender_pos * 1000  # Convert back to meters (ECEF scale)
    
    # Calculate velocity from position difference
    prev_pos = _missile_state_cache.get('prev_pos')
    prev_time = _missile_state_cache.get('prev_time')
    
    if prev_pos is not None and prev_time is not None:
        dt = t - prev_time
        if dt > 0:
            v_ecef = (p_ecef - prev_pos) / dt
        else:
            v_ecef = np.array([0.0, 0.0, 0.0])
    else:
        # For first call, estimate velocity from next frame
        if frame < bpy.context.scene.frame_end:
            bpy.context.scene.frame_set(frame + 1)
            next_blender_pos = np.array(missile.location)
            next_p_ecef = next_blender_pos * 1000
            dt = 1.0 / fps
            v_ecef = (next_p_ecef - p_ecef) / dt
            # Reset to current frame
            bpy.context.scene.frame_set(frame)
        else:
            v_ecef = np.array([0.0, 0.0, 0.0])
    
    # Update cache
    _missile_state_cache['prev_pos'] = p_ecef.copy()
    _missile_state_cache['prev_time'] = t
    
    return p_ecef, v_ecef

def setup_camera_and_lighting():
    """Setup camera and lighting for the scene"""
    # Add camera
    bpy.ops.object.camera_add(location=(10000, -10000, 5000))
    camera = bpy.context.active_object
    camera.name = "MainCamera"
    
    # Point camera at Earth
    constraint = camera.constraints.new(type='TRACK_TO')
    constraint.target = bpy.data.objects['Earth']
    constraint.track_axis = 'TRACK_NEGATIVE_Z'
    constraint.up_axis = 'UP_Y'
    
    # Set as active camera
    bpy.context.scene.camera = camera
    
    # Add sun light
    bpy.ops.object.light_add(type='SUN', location=(5000, 5000, 5000))
    sun = bpy.context.active_object
    sun.name = "Sun"
    sun.data.energy = 3

def main():
    """Main simulation setup function"""
    print("Setting up missile simulation...")
    
    # Clear scene
    clear_scene()
    
    # Create Earth with texture
    earth = create_earth_with_texture()
    print("Earth created with texture")
    
    # Create missile
    missile = create_missile()
    print("Missile created")
    
    # Calculate trajectory (NYC to DC)
    nyc_lat, nyc_lon = 40.7128, -74.0060
    dc_lat, dc_lon = 38.9072, -77.0369
    
    trajectory_points = calculate_trajectory_points(nyc_lat, nyc_lon, dc_lat, dc_lon, 100)
    print(f"Calculated {len(trajectory_points)} trajectory points")
    
    # Animate missile
    animate_missile_trajectory(missile, trajectory_points)
    print("Missile animation completed")
    
    # Setup camera and lighting
    setup_camera_and_lighting()
    print("Camera and lighting setup completed")
    
    # Set playback settings
    bpy.context.scene.frame_start = 1
    bpy.context.scene.frame_end = len(trajectory_points)
    bpy.context.scene.frame_current = 1
    
    print("Missile simulation setup complete!")
    print("Press SPACE to play animation")
    
    return missile, earth

if __name__ == "__main__":
    main()
